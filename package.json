{
  "name": "firefly",
  "version": "2.19.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 7028",
    "build": "next typegen && tsc --noEmit && next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:worker": "cd worker && bun run test",
    "test:worker:coverage": "cd worker && bun run test:coverage",
    "typecheck": "next typegen && tsc --noEmit && cd worker && tsc --noEmit",
    "lint": "bun run typecheck && biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 . && bun run gate:dynamic-delete && bun run gate:ts-expect-error && bun run gate:test-skip",
    "lint:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .",
    "gate:dynamic-delete": "bun run scripts/check-dynamic-delete.ts",
    "gate:ts-expect-error": "bun run scripts/check-ts-expect-error.ts",
    "gate:test-skip": "bun run scripts/check-test-skip.ts",
    "security": "bun scripts/run-security.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:e2e:api": "bun scripts/run-e2e.ts --api-only",
    "test:e2e:browser": "bun scripts/run-e2e.ts --browser-only",
    "test:e2e:bdd": "bun run test:e2e:browser",
    "migrate": "bun scripts/migrations/migrate.ts up",
    "migrate:status": "bun scripts/migrations/migrate.ts status",
    "migrate:local": "bun scripts/migrations/migrate.ts up --target local",
    "prepare": "husky",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.9",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxc-parser": "0.155.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nocoo/basalt": "3.2.1",
    "@nocoo/next-ai": "^0.4.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "7.0.152",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "juice": "12.2.0",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "picomatch": ">=4.0.7",
    "body-parser": "^2.4.0",
    "brace-expansion": ">=5.0.6",
    "baseline-browser-mapping": ">=2.11.27",
    "ws": ">=8.20.1",
    "path-to-regexp": ">=8.4.0",
    "hono": ">=4.13.13",
    "@hono/node-server": ">=2.1.3",
    "fast-uri": "^4.2.3",
    "fast-xml-builder": ">=1.1.7",
    "fast-xml-parser": ">=5.7.0",
    "postcss": ">=8.5.29",
    "postcss-selector-parser": ">=7.1.6",
    "ip-address": ">=10.7.4",
    "nanoid": "3.3.20",
    "qs": ">=6.16.0",
    "vite": ">=8.3.3",
    "sharp": ">=0.35.5",
    "undici": "7.30.1",
    "ai": "7.0.152",
    "@radix-ui/react-alert-dialog": "1.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json}": [
      "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 --staged"
    ]
  }
}
