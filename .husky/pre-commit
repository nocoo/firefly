#!/usr/bin/env sh

# === System0 gate: pre-commit ===
# Gates the Git index snapshot (not the working tree) with S1, S2, L1, G1 and —
# when workflows are staged — S3. See scripts/quality/slots.ts for the slot map.
set -e
command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}

snapshot=
cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

repo=$(git rev-parse --show-toplevel)
GATE_STAGED_FILES=$(git diff --cached --name-only)
export GATE_STAGED_FILES

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/firefly-index-XXXXXX")
git checkout-index --all --prefix="$snapshot/"

if [ ! -d "$repo/node_modules" ]; then
	echo "pre-commit: node_modules is required — run bun install" >&2
	exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: index must contain package.json and bun.lock" >&2
	exit 1
fi

# The installed tree must belong to the manifests being committed, otherwise the
# gates would run against dependencies that the commit does not declare.
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
	echo "pre-commit: index package.json/bun.lock must match installed worktree copies (run bun install)" >&2
	exit 1
fi
if [ -f "$snapshot/worker/package.json" ] && [ -f "$snapshot/worker/bun.lock" ]; then
	if [ ! -d "$repo/worker/node_modules" ]; then
		echo "pre-commit: worker/node_modules is required — run bun install --cwd worker" >&2
		exit 1
	fi
	if ! cmp -s "$snapshot/worker/package.json" "$repo/worker/package.json" ||
		! cmp -s "$snapshot/worker/bun.lock" "$repo/worker/bun.lock"; then
		echo "pre-commit: index worker/package.json/bun.lock must match worktree (run bun install --cwd worker)" >&2
		exit 1
	fi
fi

# Reuse the installed dependencies read-only; caches stay inside the snapshot.
mkdir "$snapshot/node_modules"
for entry in "$repo/node_modules"/*; do
	[ -e "$entry" ] || continue
	ln -s "$entry" "$snapshot/node_modules/${entry##*/}"
done
ln -s "$repo/node_modules/.bin" "$snapshot/node_modules/.bin"

if [ -d "$repo/worker/node_modules" ]; then
	mkdir -p "$snapshot/worker/node_modules"
	for entry in "$repo/worker/node_modules"/*; do
		[ -e "$entry" ] || continue
		ln -s "$entry" "$snapshot/worker/node_modules/${entry##*/}"
	done
	ln -s "$repo/worker/node_modules/.bin" "$snapshot/worker/node_modules/.bin"
fi

mkdir -p "$snapshot/node_modules/.vite" "$snapshot/node_modules/.vitest" "$snapshot/.cache"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
export GATE_GIT_ROOT="$repo"
PATH="$snapshot/node_modules/.bin:$PATH"

cd "$snapshot"

if ! grep -Fq -- '--coverage' package.json; then
	echo "pre-commit: test:coverage must invoke vitest with --coverage" >&2
	exit 1
fi

bun run scripts/quality/gate.ts --stage=pre-commit
