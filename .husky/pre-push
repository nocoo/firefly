#!/usr/bin/env sh

# === System0 gate: pre-push ===
# Verifies exactly the commits being pushed (never the working tree): one detached
# worktree per pushed OID, then G2, B1, L3, L4 plus S1/S2/L1/G1 as bypass evidence.
# Deleted refs are skipped; a new branch scans "<oid> --not --remotes" for secrets.
set -e
zero=0000000000000000000000000000000000000000
command -v git >/dev/null 2>&1 || {
	echo "pre-push: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-push: bun is required" >&2
	exit 1
}

repo=$(git rev-parse --show-toplevel)
tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/firefly-push-XXXXXX")
worktrees="$tmp_root/worktrees"
mkdir -p "$worktrees"

cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -d "$worktrees" ]; then
		for path in "$worktrees"/*; do
			[ -e "$path" ] || continue
			git worktree remove --force "$path" >/dev/null 2>&1 || :
		done
	fi
	git worktree prune >/dev/null 2>&1 || :
	rm -rf "$tmp_root" || :
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# Read every ref before running anything: gate steps inherit stdin, and a step that
# reads it would swallow the refs that have not been verified yet.
refs_file="$tmp_root/refs"
cat >"$refs_file"
if [ ! -s "$refs_file" ]; then
	echo "pre-push: no refs on stdin — this hook only runs from 'git push'" >&2
	exit 1
fi

link_tree() {
	from=$1
	to=$2
	mkdir -p "$to/node_modules"
	for entry in "$from/node_modules"/*; do
		[ -e "$entry" ] || continue
		ln -s "$entry" "$to/node_modules/${entry##*/}"
	done
	ln -s "$from/node_modules/.bin" "$to/node_modules/.bin"
}

# The worktree must run against the dependencies its own manifests declare.
prepare_dependencies() {
	worktree=$1
	if cmp -s "$worktree/package.json" "$repo/package.json" && cmp -s "$worktree/bun.lock" "$repo/bun.lock"; then
		link_tree "$repo" "$worktree"
	else
		echo "▸ manifests differ from the installed tree — frozen install in the worktree"
		(cd "$worktree" && bun install --frozen-lockfile)
	fi
	if [ -f "$worktree/worker/package.json" ] && [ -f "$worktree/worker/bun.lock" ]; then
		if cmp -s "$worktree/worker/package.json" "$repo/worker/package.json" &&
			cmp -s "$worktree/worker/bun.lock" "$repo/worker/bun.lock"; then
			link_tree "$repo/worker" "$worktree/worker"
		else
			echo "▸ worker manifests differ from the installed tree — frozen install in the worktree"
			(cd "$worktree/worker" && bun install --frozen-lockfile)
		fi
	fi
}

status=0
verified=
count=0
deleted=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$local_sha" ] || continue
	if [ "$local_sha" = "$zero" ]; then
		echo "▸ $remote_ref: deletion, no source checks"
		deleted=$((deleted + 1))
		continue
	fi

	commit=$(git rev-parse --verify "$local_sha^{commit}")
	case " $verified " in
	*" $commit "*)
		echo "▸ $remote_ref: $commit already verified in this push"
		continue
		;;
	esac
	verified="$verified $commit"
	count=$((count + 1))

	if [ "$remote_sha" = "$zero" ]; then
		range="$commit --not --remotes"
		echo "▸ $remote_ref: new ref at $commit (secret range: $range)"
	else
		range="$remote_sha..$commit"
		echo "▸ $remote_ref: $commit (range $range)"
	fi

	worktree="$worktrees/$(printf '%s' "$commit" | cut -c1-12)"
	git worktree add --detach "$worktree" "$commit" >/dev/null
	prepare_dependencies "$worktree"

	if ! (
		cd "$worktree"
		unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
		export GATE_GIT_ROOT="$repo"
		export XDG_CACHE_HOME="$tmp_root/cache"
		export XDG_STATE_HOME="$tmp_root/cache"
		mkdir -p "$XDG_CACHE_HOME"
		bun run scripts/quality/gate.ts --stage=pre-push --g1-range="$range"
	); then
		status=1
	fi
done <"$refs_file"

if [ "$count" -eq 0 ] && [ "$deleted" -eq 0 ]; then
	echo "pre-push: no source ref found in the push input" >&2
	exit 1
fi

exit $status
